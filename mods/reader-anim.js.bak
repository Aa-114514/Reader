(function(){
var rd=window.__rd;
if(!rd){return}
if(rd.modules.animLoaded){return}
rd.modules.animLoaded=1;
var c=rd.ctx,D=c.D,W=c.W,Q=c.Q,O=c.O;

var KEY='RDR_ANIM_CFG';
var DEF={enabled:1,listMode:1,pageMode:'slide',scrollFade:1,duration:520,stagger:45};
var cfg={};for(var k in DEF)cfg[k]=DEF[k];
try{var s=localStorage.getItem(KEY);if(s){var o=JSON.parse(s);for(var k2 in o)cfg[k2]=o[k2]}}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(cfg))}catch(e){}}

/* ============= 书库/书架 列表动画 ============= */
function playRow(el,idx){
  if(!cfg.enabled){el.style.opacity='';return}
  var dur=cfg.duration,delay=Math.min(idx*cfg.stagger,300);
  var tr,tr0,eo;
  if(cfg.listMode===1){
    tr0='translateX(-100vw)';tr='translateX(0)';eo='transform '+dur+'ms cubic-bezier(.34,1.4,.5,1) '+delay+'ms, opacity '+Math.round(dur*.6)+'ms ease '+delay+'ms';
  }else if(cfg.listMode===2){
    el.style.transformOrigin='left center';
    tr0='perspective(900px) rotateY(-85deg) translateX(-10px)';tr='perspective(900px) rotateY(0deg) translateX(0)';eo='transform '+dur+'ms cubic-bezier(.22,.8,.3,1) '+delay+'ms, opacity '+Math.round(dur*.6)+'ms ease '+delay+'ms';
  }else{
    el.style.transformOrigin='center bottom';
    tr0='perspective(1000px) rotateX(-85deg) translateY(8px)';tr='perspective(1000px) rotateX(0deg) translateY(0)';eo='transform '+dur+'ms cubic-bezier(.22,.8,.3,1) '+delay+'ms, opacity '+Math.round(dur*.6)+'ms ease '+delay+'ms';
  }
  el.style.opacity='0';
  el.style.willChange='transform,opacity';
  el.style.transition='none';
  el.style.transform=tr0;
  requestAnimationFrame(function(){requestAnimationFrame(function(){
    el.style.transition=eo;
    el.style.transform=tr;
    el.style.opacity='1';
    setTimeout(function(){
      el.style.removeProperty('will-change');
      el.style.removeProperty('transition');
      el.style.removeProperty('transform-origin');
      el.style.removeProperty('transform');
      el.style.removeProperty('opacity');
    },dur+delay+80);
  })});
}

function setupList(SC){
  if(!SC||SC._rdAnimSetup)return;
  SC._rdAnimSetup=1;
  var order=0;
  var io=new IntersectionObserver(function(ents){
    ents.forEach(function(en){
      if(!en.isIntersecting)return;
      var t=en.target;
      if(t._rdMark)return;
      t._rdMark=1;
      io.unobserve(t);
      playRow(t,order++);
    });
  },{root:SC,rootMargin:'60px 0px 60px 0px'});

  function scanAdd(){
    var kids=SC.children;
    for(var i=0;i<kids.length;i++){
      var k=kids[i];
      if(k._rdMark||k._rdObs)continue;
      k._rdObs=1;
      io.observe(k);
    }
  }
  scanAdd();

  var _st=null;
  SC.addEventListener('scroll',function(){
    if(_st)return;
    _st=setTimeout(function(){
      _st=null;
      var sr=SC.getBoundingClientRect();
      var kids=SC.children;
      for(var i=0;i<kids.length;i++){
        var k=kids[i];
        if(k._rdMark)continue;
        var kr=k.getBoundingClientRect();
        if(kr.bottom<sr.top-30){
          k._rdMark=1;
          io.unobserve(k);
          k.style.removeProperty('opacity');
          k.style.removeProperty('transform');
          k.style.removeProperty('transition');
        }
      }
    },80);
  },{passive:true});

  var mo=new MutationObserver(function(){scanAdd()});
  mo.observe(SC,{childList:true});
}

function checkSC(){
  var SC=Q('#SC');
  if(SC)setupList(SC);
}
var BEl=Q('#B');
if(BEl){
  new MutationObserver(function(){checkSC()}).observe(BEl,{childList:true,subtree:true});
  checkSC();
}

/* ============= 阅读器翻页动画 ============= */
function getReaderV(){return Q('#V')}

function ensureDeco(mode){
  var V=getReaderV();
  if(!V)return;
  var d=V.querySelector('.rd-adeco');
  if(!d){
    d=D.createElement('div');
    d.className='rd-adeco';
    d.style.cssText='position:absolute;top:0;bottom:0;pointer-events:none;z-index:6;opacity:.9';
    V.appendChild(d);
  }
  if(mode==='sim'){
    d.style.left='0';d.style.right='auto';d.style.width='70px';
    d.style.background='linear-gradient(to right,rgba(0,0,0,.28),rgba(0,0,0,0))';
    d.style.display='block';
  }else if(mode==='cover'){
    d.style.right='0';d.style.left='auto';d.style.width='40px';
    d.style.background='linear-gradient(to left,rgba(0,0,0,.22),rgba(0,0,0,0))';
    d.style.display='block';
  }else{
    d.style.display='none';
  }
}

function setupReaderAnim(){
  var A=Q('#A');
  if(!A)return;
  var dur=cfg.duration,ease='ease-out';
  if(cfg.pageMode==='slide')ease='cubic-bezier(.22,.61,.36,1)';
  else if(cfg.pageMode==='sim')ease='cubic-bezier(.25,.1,.25,1)';
  else if(cfg.pageMode==='cover')ease='cubic-bezier(.4,0,.2,1)';
  else ease='linear';
  A.style.transition='transform '+dur+'ms '+ease;
  ensureDeco(cfg.pageMode);
}

/* 监听 A 出现 */
var _rT=setInterval(function(){
  var A=Q('#A');
  if(A&&!A._rdHooked){
    A._rdHooked=1;
    setupReaderAnim();
  }else if(A&&A._rdHooked){
    var cur='transform '+cfg.duration+'ms';
    if((A.style.transition||'').indexOf(cur)<0)setupReaderAnim();
  }
},500);

/* ============= 上下滚动文字淡入 ============= */
function setupScrollFade(){
  if(!cfg.scrollFade)return;
  var V=getReaderV(),A=Q('#A');
  if(!V||!A)return;
  if(A._rdFadeSetup)return;
  A._rdFadeSetup=1;
  var io=new IntersectionObserver(function(ents){
    ents.forEach(function(en){
      if(!en.isIntersecting)return;
      var t=en.target;
      if(t._rdFaded)return;
      t._rdFaded=1;
      t.style.transition='opacity 480ms ease';
      t.style.opacity='1';
      io.unobserve(t);
    });
  },{root:V,rootMargin:'0px 0px -40px 0px',threshold:0.01});

  function add(){
    if(!O.classList.contains('scrollmode'))return;
    var ps=A.querySelectorAll('p');
    for(var i=0;i<ps.length;i++){
      var p=ps[i];
      if(p._rdFadeInit)continue;
      p._rdFadeInit=1;
      p.style.opacity='0';
      io.observe(p);
    }
  }
  add();
  new MutationObserver(add).observe(A,{childList:true,subtree:true});
  new MutationObserver(add).observe(O,{attributes:true,attributeFilter:['class']});
}

var _fT=setInterval(function(){
  var A=Q('#A');
  if(A&&O.classList.contains('scrollmode')&&!A._rdFadeSetup)setupScrollFade();
},800);

/* ============= 阅读器中央面板按钮 ============= */
var PM_NAMES={slide:'滑动',sim:'仿真',cover:'覆盖',shift:'平移'};
var PM_ORDER=['slide','sim','cover','shift'];

function injectReaderBtn(){
  var H=Q('#H');
  if(!H)return;
  var pane=H.querySelector('.subpane[data-ui-pane="basic"]');
  if(!pane)return;
  if(pane.querySelector('.rd-pgmode-btn'))return;
  var row=D.createElement('div');
  row.className='src';
  row.innerHTML='<label>翻页</label><button class="rd-pgmode-btn" style="flex:1">'+PM_NAMES[cfg.pageMode]+'</button>';
  var btn=row.querySelector('.rd-pgmode-btn');
  btn.onclick=function(){
    var i=PM_ORDER.indexOf(cfg.pageMode);
    cfg.pageMode=PM_ORDER[(i+1)%PM_ORDER.length];
    save();
    btn.textContent=PM_NAMES[cfg.pageMode];
    var A=Q('#A');
    if(A)A._rdHooked=0;
    setupReaderAnim();
    var tip=D.createElement('div');
    tip.style.cssText='position:fixed;left:50%;bottom:120px;transform:translateX(-50%);background:rgba(0,0,0,.85);color:#fff;padding:6px 14px;border-radius:6px;font:12px system-ui;z-index:2147483647;pointer-events:none';
    tip.textContent=PM_NAMES[cfg.pageMode];
    D.body.appendChild(tip);
    setTimeout(function(){if(tip.parentNode)tip.parentNode.removeChild(tip)},1000);
  };
  var firstRow=pane.querySelector('.src');
  if(firstRow)pane.insertBefore(row,firstRow);
  else pane.appendChild(row);
}
setInterval(injectReaderBtn,500);

/* ============= 设置界面 - 全局动画配置 ============= */
var LM_NAMES={1:'弹跳',2:'拉链',3:'纸片'};
function openAnimCfg(){
  var ov=D.createElement('div');
  ov.style.cssText='position:fixed;top:0;left:0;right:0;bottom:0;background:var(--rbg,#15161a);color:var(--rfg,#cdd0d5);z-index:2147483600;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:16px 20px 40px;box-sizing:border-box;font:14px system-ui';
  function btnRow(items,cur,cls){
    var h='<div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap">';
    items.forEach(function(it){
      h+='<button class="'+cls+'" data-v="'+it[0]+'" style="flex:1;min-width:60px;height:38px;border-radius:8px;border:0;cursor:pointer;background:'+(cur==it[0]?'#4a8fe0':'#2a2d34')+';color:#fff;font-size:13px">'+it[1]+'</button>';
    });
    return h+'</div>';
  }
  var h='<div style="display:flex;align-items:center;margin-bottom:18px"><button class="rd-anim-close" style="background:none;border:0;color:inherit;font-size:24px;padding:0 12px 0 0">←</button><b>动画配置</b></div>';
  h+='<h3 style="font-size:13px;margin:14px 0 8px;opacity:.75;border-bottom:1px solid rgba(128,128,128,.2);padding-bottom:6px">总开关</h3>';
  h+=btnRow([[1,'开'],[0,'关']],cfg.enabled?1:0,'rd-a-toggle');
  h+='<h3 style="font-size:13px;margin:14px 0 8px;opacity:.75;border-bottom:1px solid rgba(128,128,128,.2);padding-bottom:6px">书库 / 书架下拉</h3>';
  h+=btnRow([[1,LM_NAMES[1]],[2,LM_NAMES[2]],[3,LM_NAMES[3]]],cfg.listMode,'rd-a-lm');
  h+='<h3 style="font-size:13px;margin:14px 0 8px;opacity:.75;border-bottom:1px solid rgba(128,128,128,.2);padding-bottom:6px">阅读器 左右翻页</h3>';
  h+=btnRow([['slide',PM_NAMES.slide],['sim',PM_NAMES.sim],['cover',PM_NAMES.cover],['shift',PM_NAMES.shift]],cfg.pageMode,'rd-a-pm');
  h+='<h3 style="font-size:13px;margin:14px 0 8px;opacity:.75;border-bottom:1px solid rgba(128,128,128,.2);padding-bottom:6px">阅读器 上下滚动</h3>';
  h+=btnRow([[1,'淡入开'],[0,'淡入关']],cfg.scrollFade?1:0,'rd-a-sf');
  h+='<h3 style="font-size:13px;margin:14px 0 8px;opacity:.75;border-bottom:1px solid rgba(128,128,128,.2);padding-bottom:6px">时长</h3>';
  h+='<div style="display:flex;align-items:center;gap:10px;margin-bottom:12px"><input type="range" class="rd-a-dur" min="200" max="1500" step="20" value="'+cfg.duration+'" style="flex:1;accent-color:#4a8fe0"><span class="rd-a-durv" style="min-width:60px;text-align:right;font-size:13px">'+cfg.duration+'ms</span></div>';
  h+='<h3 style="font-size:13px;margin:14px 0 8px;opacity:.75;border-bottom:1px solid rgba(128,128,128,.2);padding-bottom:6px">错开</h3>';
  h+='<div style="display:flex;align-items:center;gap:10px;margin-bottom:12px"><input type="range" class="rd-a-stg" min="0" max="120" step="5" value="'+cfg.stagger+'" style="flex:1;accent-color:#4a8fe0"><span class="rd-a-stgv" style="min-width:60px;text-align:right;font-size:13px">'+cfg.stagger+'ms</span></div>';
  h+='<div style="margin-top:20px"><button class="rd-a-reset" style="width:100%;height:42px;border-radius:8px;border:0;cursor:pointer;background:#2a2d34;color:#d7dae0;font-size:14px">恢复默认</button></div>';
  h+='<div style="font-size:11px;opacity:.5;margin-top:14px;line-height:1.6">改动立即生效，切换页面/章节时体现</div>';
  ov.innerHTML=h;
  D.body.appendChild(ov);

  function refresh(){
    if(ov.parentNode)ov.parentNode.removeChild(ov);
    openAnimCfg();
  }
  ov.querySelector('.rd-anim-close').onclick=function(){if(ov.parentNode)ov.parentNode.removeChild(ov)};
  ov.querySelectorAll('.rd-a-toggle').forEach(function(b){b.onclick=function(){cfg.enabled=+b.getAttribute('data-v');save();refresh()}});
  ov.querySelectorAll('.rd-a-lm').forEach(function(b){b.onclick=function(){cfg.listMode=+b.getAttribute('data-v');save();refresh()}});
  ov.querySelectorAll('.rd-a-pm').forEach(function(b){b.onclick=function(){cfg.pageMode=b.getAttribute('data-v');save();var A=Q('#A');if(A)A._rdHooked=0;setupReaderAnim();refresh()}});
  ov.querySelectorAll('.rd-a-sf').forEach(function(b){b.onclick=function(){cfg.scrollFade=+b.getAttribute('data-v');save();refresh()}});
  var dEl=ov.querySelector('.rd-a-dur'),dV=ov.querySelector('.rd-a-durv');
  dEl.oninput=function(){cfg.duration=+this.value;dV.textContent=cfg.duration+'ms';save();var A=Q('#A');if(A)A._rdHooked=0;setupReaderAnim()};
  var sEl=ov.querySelector('.rd-a-stg'),sV=ov.querySelector('.rd-a-stgv');
  sEl.oninput=function(){cfg.stagger=+this.value;sV.textContent=cfg.stagger+'ms';save()};
  ov.querySelector('.rd-a-reset').onclick=function(){
    for(var kk in DEF)if(DEF.hasOwnProperty(kk))cfg[kk]=DEF[kk];
    save();
    var A=Q('#A');if(A)A._rdHooked=0;setupReaderAnim();
    refresh();
  };
}

function injectSettingBtn(){
  try{
    var ST=Q('#ST');
    if(!ST)return;
    if(ST.querySelector('.rd-a-open'))return;
    var wrap=D.createElement('div');
    wrap.innerHTML='<h3>动画</h3><div class="row"><button class="rd-a-open full">动画配置</button></div>';
    var btn=wrap.querySelector('.rd-a-open');
    btn.onclick=function(){try{openAnimCfg()}catch(e){alert('动画配置异常: '+e.message)}};
    var h3=null,kids=ST.children;
    for(var i=0;i<kids.length;i++){
      if(kids[i].tagName==='H3'&&/其它/.test(kids[i].textContent)){h3=kids[i];break}
    }
    if(h3)ST.insertBefore(wrap,h3);else ST.appendChild(wrap);
  }catch(e){}
}
if(D.body)new MutationObserver(function(){injectSettingBtn();injectReaderBtn()}).observe(D.body,{childList:true,subtree:true});
setTimeout(injectSettingBtn,300);

rd.modules.anim={cfg:cfg,reload:function(){var A=Q('#A');if(A)A._rdHooked=0;setupReaderAnim()}};
})();